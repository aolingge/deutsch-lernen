---
// @ts-nocheck
import { accessLabels, categoryById, priceLabels } from '../data';
const { resource, compact = false } = Astro.props;
/** @type {import('../types').Resource} */
const item = resource;
const category = categoryById.get(item.primaryCategory);
const statusLabel = item.linkStatus === 'restricted' ? '自动检查受限' : item.linkStatus === 'broken' ? '待替换' : item.linkStatus === 'ok' ? '已核验' : '待核验';
---
<article class:list={['resource-card', { compact }]}>
  <div class="card-top"><span class="eyebrow">{category?.accent ?? '资源'}</span><span class:list={['check-status', item.linkStatus]}>{statusLabel}</span></div>
  <h3><a href={`/resource/${item.slug}/`}>{item.titleZh}</a></h3>
  {item.titleOriginal && <p class="original">{item.titleOriginal}</p>}
  <p class="description">{item.descriptionZh}</p>
  <div class="chips">{item.levels.map((level: string) => <span>{level}</span>)}{item.skills.slice(0, 2).map((skill: string) => <span>{skill}</span>)}</div>
  <div class="card-meta"><span>{priceLabels[item.price]}</span><span>{accessLabels[item.access]}</span><span>{item.sourceName}</span></div>
  <div class="card-actions"><a class="text-link" href={`/resource/${item.slug}/`}>查看说明 <span>↗</span></a><a class="external" href={item.url} target="_blank" rel="noreferrer">打开原站</a></div>
</article>
<style>
.resource-card{background:white;border:1px solid var(--line);border-radius:10px;padding:20px;display:flex;flex-direction:column;min-height:310px;box-shadow:0 8px 24px rgba(27,46,81,.04)}.resource-card:hover{border-color:#a9bce9;box-shadow:0 12px 28px rgba(27,46,81,.08)}.resource-card.compact{min-height:260px;padding:17px}.card-top,.card-meta,.card-actions{display:flex;align-items:center;justify-content:space-between;gap:10px}.eyebrow{font:500 11px 'DM Mono',monospace;color:var(--blue);text-transform:uppercase;letter-spacing:.08em}.check-status{font:500 10px 'DM Mono',monospace;color:#2e7b53}.check-status.restricted{color:#9a6b16}.check-status.broken{color:var(--red)}h3{font-size:19px;line-height:1.3;margin:17px 0 2px;letter-spacing:-.03em}h3 a{text-decoration:none}.original{color:var(--muted);font:11px 'DM Mono',monospace;margin:0 0 11px}.description{color:#5b6679;font-size:13px;line-height:1.7;margin:0 0 15px}.chips{display:flex;flex-wrap:wrap;gap:6px;margin:auto 0 16px}.chips span{background:#eef3ff;border-radius:4px;color:#3555a2;font-size:11px;padding:4px 7px}.card-meta{border-top:1px solid #edf0f5;padding-top:12px;color:#7a8494;font-size:11px;flex-wrap:wrap;justify-content:flex-start}.card-actions{border-top:1px solid #edf0f5;margin-top:14px;padding-top:13px;font-size:12px}.text-link{font-weight:700;color:var(--blue);text-decoration:none}.text-link span{font-size:15px}.external{color:#7a8494;text-decoration:none}.external:hover{text-decoration:underline}
</style>
