---
import ResourceFilters from './ResourceFilters.astro';
import ResourceCard from './ResourceCard.astro';
import { categories, resources } from '../data';
import { selectResources } from '../lib/resource-directory.mjs';
const { title = '德语资源导航', description = '课程、词典、播客、考试与德国生活信息。', category = '', level = '', saved = false } = Astro.props;
const basePath = Astro.url.pathname;
const params = new URLSearchParams();
if (category) params.set('category', category);
if (level) params.set('level', level);
const selected = selectResources(resources, params);
const count = (id: string) => resources.filter((r) => r.primaryCategory === id).length;
---
<section class="directory-intro shell"><div><p class="eyebrow">DEUTSCH / RESOURCE DIRECTORY</p><h1>{title}<span class="title-dot">.</span></h1><p class="intro-line">{description}</p></div><div class="directory-stats"><span><strong data-resource-count>{resources.length}</strong> 个资源</span><span><strong>{categories.length}</strong> 个分类</span><a href="/sources/">收录说明 ↗</a></div></section>
<div class="directory-workspace shell" data-directory data-default-category={category} data-default-level={level} data-saved-only={String(saved)}>
  <aside class="directory-sidebar"><div class="sidebar-head"><span>资源分类</span><span class="sidebar-index">INDEX</span></div><nav aria-label="资源分类"><a class="category-link" data-category="" href={basePath}><span class="category-number">⌘</span><span>全部资源</span><small data-category-count="">{resources.length}</small></a>{categories.map((c, i) => <a class="category-link" data-category={c.id} href={`${basePath}?category=${c.id}`}><span class="category-number">{String(i + 1).padStart(2, '0')}</span><span>{c.name}</span><small data-category-count={c.id}>{count(c.id)}</small></a>)}</nav><a class="sidebar-saved" href="/favorites/">☆ 我的收藏 <span data-favorite-count>0</span></a><p class="sidebar-note">链接到原站<br />不复制第三方内容</p></aside>
  <section class="directory-main" aria-label="资源目录"><ResourceFilters basePath={basePath} /><div class="active-filters" data-active-filters aria-label="已选筛选条件"></div><div class="catalog-head"><div><h2 data-directory-heading>{saved ? '我的收藏' : '全部资源'}</h2><span data-result-count role="status" aria-live="polite">{saved ? '读取中' : `${selected.length} 个资源`}</span></div><div class="catalog-controls"><label><span class="sr-only">排序</span><select name="sort" form="resource-filters" aria-label="排序"><option value="default">默认顺序</option><option value="title">原文名称 A–Z</option><option value="updated">最近核验</option></select></label><div class="view-switch" aria-label="显示方式"><button type="button" data-view-toggle="grid" aria-label="卡片视图" aria-pressed="true"><svg aria-hidden="true" viewBox="0,0,20,20"><path d="M3 3h5v5H3zM12 3h5v5h-5zM3 12h5v5H3zM12 12h5v5h-5z" /></svg></button><button type="button" data-view-toggle="list" aria-label="列表视图" aria-pressed="false"><svg aria-hidden="true" viewBox="0,0,20,20"><path d="M3 4h14v2H3zM3 9h14v2H3zM3 14h14v2H3z" /></svg></button></div></div></div>
    <div class="resource-grid" data-catalog-grid data-view="grid">{!saved && selected.slice(0, 24).map((r) => <ResourceCard resource={r} />)}</div><nav class="catalog-pager" aria-label="资源分页"></nav><p class="directory-status" id="directory-note" role="status"></p><noscript><p>启用 JavaScript 可搜索、筛选和收藏。完整资源见下方目录。</p><div class="resource-grid">{selected.slice(24).map((r) => <ResourceCard resource={r} />)}</div></noscript>
  </section>
</div>
