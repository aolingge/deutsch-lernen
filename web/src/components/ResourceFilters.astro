---
import { categories, levelLabels, resources } from '../data';
const skills = [...new Set(resources.flatMap((resource) => resource.skills))].sort();
const exams = [...new Set(resources.flatMap((resource) => resource.exams))].filter(Boolean).sort();
const { basePath = '/resources/' } = Astro.props;
---
<form class="filters" action={basePath} method="get">
  <label class="search-label"><span>搜索资源</span><input name="q" value={Astro.url.searchParams.get('q') ?? ''} placeholder="课程、B1、听力、词典…" /></label>
  <label><span>等级</span><select name="level"><option value="">全部等级</option>{levelLabels.map((level) => <option value={level} selected={Astro.url.searchParams.get('level') === level}>{level}</option>)}</select></label>
  <label><span>分类</span><select name="category"><option value="">全部类别</option>{categories.map((category) => <option value={category.id} selected={Astro.url.searchParams.get('category') === category.id}>{category.name}</option>)}</select></label>
  <label><span>技能</span><select name="skill"><option value="">全部技能</option>{skills.map((skill) => <option value={skill} selected={Astro.url.searchParams.get('skill') === skill}>{skill}</option>)}</select></label>
  <label><span>考试</span><select name="exam"><option value="">全部考试</option>{exams.map((exam) => <option value={exam} selected={Astro.url.searchParams.get('exam') === exam}>{exam}</option>)}</select></label>
  <button type="submit">应用筛选</button><a class="reset" href={basePath}>重置</a>
</form>
<style>.filters{background:#eef3fa;border:1px solid #d7e0ee;border-radius:10px;padding:15px;display:flex;gap:10px;align-items:end;flex-wrap:wrap}.filters label{display:flex;flex-direction:column;gap:5px;flex:1;min-width:125px}.filters label span{font:500 10px 'DM Mono',monospace;color:#607089;text-transform:uppercase;letter-spacing:.06em}.filters input,.filters select{height:39px;border:1px solid #cfd9e8;border-radius:6px;background:white;padding:0 10px;color:var(--ink);font:13px Manrope}.filters .search-label{flex:2;min-width:220px}.filters button{height:39px;border:0;border-radius:6px;background:var(--blue);color:white;font-weight:700;padding:0 17px;cursor:pointer}.reset{font-size:12px;color:#627087;text-decoration:none;padding:12px 3px}.reset:hover{text-decoration:underline}@media(max-width:600px){.filters label,.filters .search-label{min-width:calc(50% - 5px)}.filters button{width:100%}.reset{margin:auto}}
</style>
