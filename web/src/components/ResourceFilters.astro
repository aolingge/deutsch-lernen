---
import { icon } from '../lib/icons.mjs';
import { levelLabels, resources } from '../data';
import { priceLabels, accessLabels } from '../lib/resource-directory.mjs';
import { providerKey } from '../lib/catalog-facets.mjs';
const prices = [...new Set(resources.map((r) => r.price))];
const access = [...new Set(resources.map((r) => r.access))];
const skills = [...new Set(resources.flatMap((r) => r.skills))].sort();
const exams = [...new Set(resources.flatMap((r) => r.exams))].filter((v) => v && v !== '非考试专项').sort();
const formats = [...new Set(resources.flatMap((r) => r.mediaTypes?.length ? r.mediaTypes : r.formats))].sort();
const providers = [...new Map(resources.map(r => [providerKey(r), r.sourceName]))].sort((a, b) => a[1].localeCompare(b[1], 'de'));
const { basePath = '/resources/' } = Astro.props;
---
<form id="resource-filters" class="filters" action={basePath} method="get">
  <div class="search-row"><label class="search-box"><span aria-hidden="true" class="search-icon" set:html={icon('search')} /><span class="sr-only">搜索资源</span><input type="search" name="q" placeholder="搜索名称、关键词或网站…" autocomplete="off" /><kbd aria-hidden="true">/</kbd></label><button type="submit" class="search-submit">搜索</button></div>
  <input type="hidden" name="category" />
  <div class="filter-row primary-filters">
    <label><span>形式</span><select name="format" aria-label="资源形式"><option value="">全部形式</option>{formats.map((format) => <option value={format}>{format}</option>)}</select></label>
    <label><span>费用</span><select name="price" aria-label="费用"><option value="">全部费用</option>{prices.map((price) => <option value={price}>{priceLabels[price]}</option>)}</select></label>
  </div>
  <details class="advanced-filters" data-advanced-filters>
    <summary><span class="filter-summary-icon" aria-hidden="true" set:html={icon('list')} /><span>更多筛选</span><span class="filter-count" data-advanced-count hidden></span><span class="disclosure-arrow" aria-hidden="true">⌄</span></summary>
    <div class="filter-row">
    <label><span>语言等级</span><select name="level" aria-label="等级"><option value="">全部等级</option>{levelLabels.map((level) => <option value={level}>{level}</option>)}</select></label>
    <label><span>技能 / 主题</span><select name="skill"><option value="">全部主题</option>{skills.map((skill) => <option value={skill}>{skill}</option>)}</select></label>
    <label><span>考试</span><select name="exam"><option value="">全部考试</option>{exams.map((exam) => <option value={exam}>{exam}</option>)}</select></label>
    <label><span>访问</span><select name="access"><option value="">全部条件</option>{access.map((value) => <option value={value}>{accessLabels[value]}</option>)}</select></label>
    <label><span>来源</span><select name="provider"><option value="">全部来源</option>{providers.map(([id, name]) => <option value={id}>{name}</option>)}</select></label>
    </div>
  </details>
</form>
