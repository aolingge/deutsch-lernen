---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data';
---
<BaseLayout title="资源管理">
  <section class="admin-shell">
    <h1>资源管理</h1>
    <p id="admin-status" role="status">正在检查管理员登录…</p>
    <div id="admin-editor" hidden>
      <div class="admin-toolbar"><button id="new-resource">新增资源</button><button id="export-catalog">导出公开目录</button><select id="resource-picker" aria-label="选择资源"><option value="">选择资源</option></select></div>
      <form id="resource-form">
        <label>资源 ID<input name="id" required pattern="[a-z0-9-]+" /></label>
        <label>路径名<input name="slug" required pattern="[a-z0-9-]+" /></label>
        <label>中文名称<input name="titleZh" required /></label>
        <label>原文名称<input name="titleOriginal" required /></label>
        <label>中文用途<textarea name="descriptionZh" required></textarea></label>
        <label>历史使用说明（可选）<textarea name="howToUseZh"></textarea></label>
        <label>主分类<select name="primaryCategory">{categories.map(c => <option value={c.id}>{c.name}</option>)}</select></label>
        <label>来源<input name="sourceName" required /></label>
        <label>来源 ID（可选）<input name="providerId" pattern="[a-z0-9-]+" /></label>
        <label>原站链接<input name="url" type="url" required /></label>
        <label>等级（逗号分隔）<input name="levels" placeholder="A1,A2,B1" /></label>
        <label>技能（逗号分隔）<input name="skills" placeholder="听力,阅读" required /></label>
        <label>标签（逗号分隔）<input name="tags" required /></label>
        <label>考试（逗号分隔）<input name="exams" placeholder="Goethe,telc" /></label>
        <label>内容形式（逗号分隔）<input name="formats" placeholder="网页,练习" required /></label>
        <label>媒体类型（逗号分隔）<input name="mediaTypes" placeholder="网页,音频" /></label>
        <label>内容语言（逗号分隔）<input name="languages" placeholder="德语,中文" required /></label>
        <label>费用<select name="price"><option value="unknown">待核实</option><option value="free">免费</option><option value="freemium">部分免费</option><option value="paid">付费</option></select></label>
        <label>费用说明（可选）<input name="costNoteZh" /></label>
        <label>使用条件<select name="access"><option value="unknown">待核实</option><option value="open">免注册</option><option value="registration">需注册</option><option value="exam-registration">需报名资格</option></select></label>
        <label>访问说明（可选）<input name="accessNoteZh" /></label>
        <label>等级依据<select name="levelBasis"><option value="editorial">本站建议</option><option value="official">官网标注</option><option value="unspecified">未标级</option></select></label>
        <label>等级范围<select name="levelScope"><option value="learning">语言学习</option><option value="any">不限制等级</option><option value="information">信息服务</option></select></label>
        <label>状态<select name="status"><option value="draft">草稿</option><option value="published">公开</option><option value="archived">归档</option></select></label>
        <label>链接状态<select name="linkStatus"><option value="unchecked">待核验</option><option value="ok">链接可访问</option><option value="restricted">检查受限</option><option value="broken">失效</option></select></label>
        <label>核验日期<input name="lastEditorialCheckedAt" type="date" /></label>
        <button type="submit">保存资源</button>
        <p>保存公开资源后，前台会在缓存刷新后显示。并发修改发生冲突时，请重新读取资源后再编辑。</p>
      </form>
      <details><summary>导入资源 JSON（先预览，保存为草稿）</summary><input id="catalog-file" type="file" accept="application/json" /><pre id="import-preview"></pre><button id="save-import" disabled>保存预览中的草稿</button></details>
    </div>
    <p><a href="/resources/">返回公开资源库</a></p>
  </section>
</BaseLayout>
<script>import '../client/admin';</script>
<style>
  .admin-shell{max-width:1000px;margin:45px auto;padding:0 22px}.admin-toolbar{display:flex;flex-wrap:wrap;gap:12px;margin:25px 0}form{display:grid;grid-template-columns:1fr 1fr;gap:18px}label{display:flex;flex-direction:column;gap:6px;font-size:13px}input,select,textarea{width:100%;padding:10px;border:1px solid #becce0;border-radius:5px;background:white;font:inherit}textarea{min-height:100px}button{padding:12px 18px;background:var(--blue);color:white;border:0;border-radius:5px;cursor:pointer}button:disabled{opacity:.5}details{margin-top:25px}pre{white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:600px){form{grid-template-columns:1fr}}
</style>
