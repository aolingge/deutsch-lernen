---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { resources } from '../../data';
const news = resources.filter((resource) => resource.primaryCategory === 'news' || resource.primaryCategory === 'reading');
---
<BaseLayout title="新闻与阅读"><section class="news-hero shell"><p class="kicker">READ THE WORLD / DEUTSCH INPUT</p><h1>新闻不是背景音，<br /><em>它是你的练习材料。</em></h1><p>从简明新闻开始，逐步过渡到自然语速和复杂主题。每个入口都标注难度依据与适合的训练方式。</p></section><section class="shell news-layout"><aside><div class="method"><span>01</span><strong>先读</strong><p>抓住标题、人物、地点和动作。</p></div><div class="method"><span>02</span><strong>再听</strong><p>隐藏文本，听出主题和三处细节。</p></div><div class="method"><span>03</span><strong>复述</strong><p>用三句话说出你理解的内容。</p></div></aside><div><div class="section-title"><h2>适合学习的新闻与读物</h2><span>{news.length} 个入口</span></div><div class="resource-grid">{news.map((resource) => <ResourceCard resource={resource} />)}</div></div></section></BaseLayout>
<style>.shell{max-width:1180px;margin:auto;padding-left:28px;padding-right:28px}.news-hero{padding-top:65px;padding-bottom:54px}.kicker{font:500 11px 'DM Mono',monospace;color:var(--blue);letter-spacing:.12em}.news-hero h1{font-size:clamp(42px,6vw,70px);line-height:1.05;letter-spacing:-.07em;margin:20px 0}.news-hero h1 em{font-style:normal;color:var(--blue)}.news-hero p:last-child{color:#687487;line-height:1.8;max-width:600px}.news-layout{display:grid;grid-template-columns:200px 1fr;gap:65px;padding-bottom:80px}.method{border-top:1px solid var(--line);padding:16px 0}.method span{font:500 10px 'DM Mono',monospace;color:var(--gold)}.method strong{display:block;font-size:16px;margin-top:10px}.method p{font-size:11px;line-height:1.6;color:#7a8698}.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.section-title h2{font-size:26px;letter-spacing:-.05em;margin:0}.section-title span{font:500 10px 'DM Mono',monospace;color:#7c899c}.resource-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}@media(max-width:760px){.shell{padding-left:18px;padding-right:18px}.news-layout{grid-template-columns:1fr;gap:28px}.news-layout aside{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.resource-grid{grid-template-columns:1fr}.section-title{display:block}.section-title span{display:block;margin-top:7px}}
</style>
