---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceDirectory from '../components/ResourceDirectory.astro';
---
<BaseLayout title="我的收藏"><section class="favorites-tools shell" aria-label="收藏备份"><button type="button" data-export-favorites>导出收藏</button><label class="file-button">导入收藏<input type="file" accept="application/json" data-import-favorites /></label><span id="directory-note" role="status"></span></section><ResourceDirectory title="我的收藏" description="收藏保存在当前浏览器，无需登录。" saved /></BaseLayout>
