---
// @ts-nocheck
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { accessLabels, categoryById, priceLabels, resources } from '../../data';
export function getStaticPaths() { return resources.map((resource) => ({ params: { slug: resource.slug }, props: { resource } })); }
const { resource } = Astro.props;
const category = categoryById.get(resource.primaryCategory);
const related = resources.filter((item) => item.primaryCategory === resource.primaryCategory && item.id !== resource.id).slice(0, 3);
---
<BaseLayout title={resource.titleZh} description={resource.descriptionZh}><section class="detail shell"><a class="back" href="/resources/">← 返回资源库</a><div class="detail-label"><span>{category?.name}</span><span>{resource.linkStatus === 'restricted' ? '自动检查受限' : resource.linkStatus === 'ok' ? '链接已核验' : '待核验'}</span></div><h1>{resource.titleZh}</h1>{resource.titleOriginal && <p class="original">{resource.titleOriginal}</p>}<p class="intro">{resource.descriptionZh}</p><div class="detail-grid"><div><div class="detail-block"><h2>这是什么</h2><p>{resource.descriptionZh}</p></div><div class="detail-block"><h2>怎么使用</h2><p>{resource.howToUseZh}</p></div><div class="detail-block"><h2>适合什么阶段</h2><div class="chips">{resource.levels.map((level) => <span>{level}</span>)}{resource.skills.map((skill) => <span>{skill}</span>)}</div><p class="basis">等级依据：{resource.levelBasis === 'official' ? '来源官网标注' : resource.levelBasis === 'editorial' ? '本站编辑建议' : '尚未标级'}</p></div></div><aside><div class="fact-panel"><div><small>费用</small><strong>{priceLabels[resource.price]}</strong></div><div><small>使用条件</small><strong>{accessLabels[resource.access]}</strong></div><div><small>来源</small><strong>{resource.sourceName}</strong></div><div><small>最近核验</small><strong>{resource.lastEditorialCheckedAt ?? '待核验'}</strong></div><a class="primary-button" href={resource.url} target="_blank" rel="noreferrer">打开官方原站 ↗</a><button class="save-button" data-save={resource.id}>☆ 加入我的收藏</button><p class="save-note" data-save-note></p></div></aside></div></section>{related.length > 0 && <section class="related shell"><div class="section-title"><h2>同一分类的其他入口</h2><a href={`/resources/?category=${resource.primaryCategory}`}>查看全部 →</a></div><div class="resource-grid">{related.map((item) => <ResourceCard resource={item} compact />)}</div></section>}</BaseLayout>

<style>.shell{max-width:1100px;margin:auto;padding-left:28px;padding-right:28px}.detail{padding-top:45px}.back{font-size:12px;color:#65738a;text-decoration:none}.detail-label{display:flex;gap:14px;font:500 11px 'DM Mono',monospace;color:var(--blue);margin-top:43px}.detail-label span+span{color:#9a6b16}.detail h1{font-size:clamp(38px,6vw,64px);letter-spacing:-.07em;line-height:1.05;margin:18px 0 5px}.original{font:12px 'DM Mono',monospace;color:#7c8899;margin:0}.intro{font-size:18px;line-height:1.7;color:#5f6b7e;max-width:740px;margin:28px 0 55px}.detail-grid{display:grid;grid-template-columns:1fr 330px;gap:75px}.detail-block{border-top:1px solid var(--line);padding:22px 0}.detail-block h2{font-size:14px;margin:0 0 11px}.detail-block p{color:#647185;font-size:14px;line-height:1.8;margin:0}.chips{display:flex;flex-wrap:wrap;gap:7px}.chips span{background:#eef3ff;color:#3555a2;border-radius:4px;padding:5px 8px;font-size:11px}.basis{margin-top:14px!important;font-size:11px!important;color:#8a96a6!important}.fact-panel{background:white;border:1px solid var(--line);border-radius:9px;padding:21px;box-shadow:0 12px 30px rgba(27,46,81,.06)}.fact-panel>div{border-bottom:1px solid #edf0f4;padding:11px 0;display:flex;justify-content:space-between;gap:12px}.fact-panel small{color:#8490a0;font-size:11px}.fact-panel strong{font-size:12px;text-align:right}.primary-button,.save-button{display:block;width:100%;border-radius:5px;text-align:center;padding:12px 10px;margin-top:19px;font-size:12px;font-weight:800;text-decoration:none;cursor:pointer}.primary-button{background:var(--blue);color:white;border:0}.save-button{background:white;color:var(--blue);border:1px solid #a9bde8}.save-note{font-size:10px!important;color:#3a825b!important;text-align:center;margin-top:10px!important;min-height:15px}.related{padding-top:75px;padding-bottom:80px}.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.section-title h2{font-size:24px;letter-spacing:-.04em}.section-title a{font-size:12px;color:var(--blue);text-decoration:none}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}@media(max-width:760px){.shell{padding-left:18px;padding-right:18px}.detail-grid{grid-template-columns:1fr;gap:25px}.intro{font-size:16px;margin-bottom:34px}.resource-grid{grid-template-columns:1fr}}
</style>

