---
// @ts-nocheck
import BaseLayout from '../layouts/BaseLayout.astro';
import { resources } from '../data';
---
<BaseLayout title="我的学习"><section class="study-hero shell"><p class="kicker">MY STUDY / LOCAL ONLY</p><h1>把下一周，<em>写下来。</em></h1><p>收藏和计划只保存在当前浏览器。你可以导出备份，也可以随时清空；网站不会把个人进度写入公开目录。</p></section><section class="shell study-grid"><div class="panel goal-panel"><div class="panel-heading"><h2>我的目标</h2><span>可选</span></div><label>目标等级<select id="goal-level"><option value="">还没有确定</option><option>A1</option><option>A2</option><option>B1</option><option>B2</option><option>C1</option><option>C2</option></select></label><label>目标考试<select id="goal-exam"><option value="">暂未选择</option><option>Goethe</option><option>telc</option><option>TestDaF</option><option>DSH</option><option>ÖSD</option></select></label><label>每周投入（小时）<input id="goal-hours" type="number" min="1" max="80" placeholder="例如 5" /></label><button class="primary-button" id="save-goal">保存目标</button><p class="saved-note" id="goal-note"></p></div><div class="panel"><div class="panel-heading"><h2>本周计划</h2><span id="task-count">0 / 0 完成</span></div><div id="task-list" class="task-list"><p class="empty-note">先在资源详情中收藏入口，再把它加入本周计划。</p></div><button class="outline-button" id="export-plan">导出学习计划</button><label class="import-label">导入备份<input id="import-plan" type="file" accept="application/json" /></label><p class="saved-note" id="plan-note"></p></div><div class="panel favorites-panel"><div class="panel-heading"><h2>我的收藏</h2><span id="favorite-count">0 个</span></div><div id="favorite-list" class="favorite-list"><p class="empty-note">收藏的资源会出现在这里。</p></div></div></section><section class="shell privacy-strip"><strong>隐私边界</strong><span>个人目标、收藏和完成状态只写入浏览器 localStorage；导出的 JSON 由你自己保存。</span><button id="clear-plan" class="danger-button">清空本机计划</button></section></BaseLayout>
<script define:vars={{ resources }}>
const key='deutsch-hub.study.v1';const initial={goal:{level:'',exam:'',hours:''},favorites:[],tasks:[]};const read=()=>{try{return {...initial,...JSON.parse(localStorage.getItem(key)||'{}')}}catch{return initial}};const write=(data)=>localStorage.setItem(key,JSON.stringify(data));const byId=new Map(resources.map((r)=>[r.id,r]));const safe=(value)=>String(value??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const render=()=>{const data=read();document.querySelector('#goal-level').value=data.goal?.level||'';document.querySelector('#goal-exam').value=data.goal?.exam||'';document.querySelector('#goal-hours').value=data.goal?.hours||'';const done=data.tasks.filter((t)=>t.done).length;document.querySelector('#task-count').textContent=`${done} / ${data.tasks.length} 完成`;document.querySelector('#favorite-count').textContent=`${data.favorites.length} 个`;const taskList=document.querySelector('#task-list');taskList.innerHTML=data.tasks.length?data.tasks.map((task,i)=>`<label class="task"><input type="checkbox" data-task="${i}" ${task.done?'checked':''}/><span>${safe(task.title)}<small>${safe(task.minutes||30)} 分钟</small></span></label>`).join(''):'<p class="empty-note">先在资源详情中收藏入口，再把它加入本周计划。</p>';const favList=document.querySelector('#favorite-list');favList.innerHTML=data.favorites.length?data.favorites.map((id)=>{const r=byId.get(id);return r?`<a href="/resource/${r.slug}/"><strong>${safe(r.titleZh)}</strong><small>${safe(r.sourceName)} · ${safe(r.levels.join(' · '))}</small></a>`:''}).join(''):'<p class="empty-note">收藏的资源会出现在这里。</p>';document.querySelectorAll('[data-task]').forEach((input)=>input.addEventListener('change',()=>{const d=read();d.tasks[Number(input.dataset.task)].done=input.checked;write(d);render()}))};document.querySelector('#save-goal').addEventListener('click',()=>{const d=read();d.goal={level:document.querySelector('#goal-level').value,exam:document.querySelector('#goal-exam').value,hours:document.querySelector('#goal-hours').value};write(d);document.querySelector('#goal-note').textContent='目标已保存在本浏览器。'});document.querySelector('#export-plan').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(read(),null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='deutsch-lernen-study-plan.json';a.click();URL.revokeObjectURL(a.href)});document.querySelector('#import-plan').addEventListener('change',(event)=>{const file=event.target.files?.[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const next=JSON.parse(reader.result);if(!Array.isArray(next.favorites)||!Array.isArray(next.tasks))throw Error('invalid');write({...initial,...next});document.querySelector('#plan-note').textContent='备份已导入。';render()}catch{document.querySelector('#plan-note').textContent='文件格式不正确，原计划未改变。'}};reader.readAsText(file)});document.querySelector('#clear-plan').addEventListener('click',()=>{if(confirm('确定清空当前浏览器中的学习计划吗？')){localStorage.removeItem(key);render()}});render();
</script>
<style>.shell{max-width:1120px;margin:auto;padding-left:28px;padding-right:28px}.study-hero{padding-top:65px;padding-bottom:48px}.kicker{font:500 11px 'DM Mono',monospace;letter-spacing:.12em;color:var(--blue)}.study-hero h1{font-size:clamp(44px,6vw,70px);letter-spacing:-.07em;margin:20px 0;line-height:1.05}.study-hero em{font-style:normal;color:var(--blue)}.study-hero p:last-child{color:#687487;line-height:1.8;max-width:600px}.study-grid{display:grid;grid-template-columns:260px 1fr 1fr;gap:14px;align-items:start}.panel{background:white;border:1px solid var(--line);border-radius:8px;padding:21px}.panel-heading{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid #edf0f4;padding-bottom:13px;margin-bottom:14px}.panel-heading h2{font-size:18px;letter-spacing:-.04em;margin:0}.panel-heading span{font:500 10px 'DM Mono',monospace;color:#7d899a}.panel label{display:block;font-size:11px;color:#758196;margin:15px 0}.panel select,.panel input[type=number]{display:block;width:100%;height:38px;margin-top:6px;padding:0 9px;border:1px solid #cad6e5;border-radius:5px;background:#fbfcfe;font:13px Manrope;color:var(--ink)}.primary-button,.outline-button,.danger-button{width:100%;height:39px;border-radius:5px;font-weight:800;font-size:12px;cursor:pointer}.primary-button{background:var(--blue);color:white;border:0}.outline-button{background:white;color:var(--blue);border:1px solid #a9bde8;margin-top:15px}.import-label{border:1px dashed #becbdc;padding:10px;text-align:center;cursor:pointer}.import-label input{display:none}.saved-note{font-size:10px;color:#328158;min-height:14px;text-align:center}.empty-note{font-size:12px;line-height:1.6;color:#8a95a5}.task-list{min-height:180px}.task{display:flex!important;gap:10px;align-items:flex-start;margin:0!important;padding:12px 0;border-bottom:1px solid #edf0f4;color:var(--ink)!important}.task input{margin-top:3px}.task span{font-size:12px}.task small,.favorite-list small{display:block;color:#8994a5;font:10px 'DM Mono',monospace;margin-top:4px}.favorite-list a{display:block;border-bottom:1px solid #edf0f4;padding:13px 0;text-decoration:none}.favorite-list strong{font-size:12px;display:block}.privacy-strip{margin-top:28px;background:#edf2f9;padding:18px 21px;display:flex;align-items:center;gap:17px;border-radius:7px;font-size:11px;color:#687487}.privacy-strip strong{color:var(--ink);white-space:nowrap}.danger-button{width:auto;margin-left:auto;padding:0 13px;background:white;color:#b14c47;border:1px solid #e6b3b0;white-space:nowrap}@media(max-width:900px){.study-grid{grid-template-columns:1fr 1fr}.goal-panel{grid-column:1/-1}.privacy-strip{flex-wrap:wrap}.danger-button{margin-left:0}}@media(max-width:600px){.shell{padding-left:18px;padding-right:18px}.study-grid{grid-template-columns:1fr}.privacy-strip{display:block}.privacy-strip span{display:block;margin:10px 0 15px}.danger-button{width:100%}}
</style>
