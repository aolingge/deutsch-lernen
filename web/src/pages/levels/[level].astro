---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceDirectory from '../../components/ResourceDirectory.astro';
export function getStaticPaths() { return ['a1', 'a2', 'b1', 'b2', 'c1', 'c2'].map((level) => ({ params: { level } })); }
const level = Astro.params.level!.toUpperCase();
---
<BaseLayout title={`${level} 德语资源`}><ResourceDirectory title={`${level} 德语资源`} description="按等级整理的课程、练习、音视频与工具。" level={level} /></BaseLayout>
