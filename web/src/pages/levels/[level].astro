---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { levelLabels, resources } from '../../data';
export function getStaticPaths() { return levelLabels.map((level) => ({ params: { level: level.toLowerCase() }, props: { level } })); }
const { level } = Astro.props;
const matching = resources.filter((resource) => resource.levels.includes(level));
const recommendations = matching.slice(0, 6);
---
<BaseLayout title={`${level} 学习路线`}><section class="level-hero shell"><p class="kicker">LEVEL ROUTE / {level}</p><h1>{level} 的下一步，<em>要能执行。</em></h1><p>这里把适合 {level} 的课程、输入、练习和考试入口集中起来。先选一条主线，再补一个技能。</p></section><section class="shell route"><div class="route-card"><span>建议组合</span><strong>1 个主线课程 + 1 个输入源 + 1 个输出任务</strong><p>不要同时收藏十个课程。选一个能连续使用的主线，每周用听读材料输入，再把新表达放进自己的句子。</p><a href="/my-study/">把它加入我的计划 →</a></div><div class="route-content"><div class="section-title"><h2>{level} 资源入口</h2><span>{matching.length} 个匹配结果</span></div><div class="resource-grid">{recommendations.map((resource) => <ResourceCard resource={resource} />)}</div></div></section></BaseLayout>
<style>.shell{max-width:1180px;margin:auto;padding-left:28px;padding-right:28px}.level-hero{padding-top:65px;padding-bottom:54px}.kicker{font:500 11px 'DM Mono',monospace;letter-spacing:.12em;color:var(--blue)}.level-hero h1{font-size:clamp(43px,6vw,70px);letter-spacing:-.07em;margin:20px 0;line-height:1.04}.level-hero em{font-style:normal;color:var(--blue)}.level-hero p:last-child{color:#687487;line-height:1.8;max-width:600px}.route{display:grid;grid-template-columns:250px 1fr;gap:62px;padding-bottom:80px}.route-card{background:var(--mint);border-radius:8px;padding:20px;align-self:start}.route-card span{font:500 10px 'DM Mono',monospace;color:#32755a}.route-card strong{display:block;font-size:18px;line-height:1.35;margin:19px 0 12px;letter-spacing:-.03em}.route-card p{font-size:12px;line-height:1.7;color:#527463}.route-card a{font-size:12px;color:#1e6549;font-weight:800;text-decoration:none}.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.section-title h2{font-size:26px;letter-spacing:-.05em;margin:0}.section-title span{font:500 10px 'DM Mono',monospace;color:#7c899c}.resource-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}@media(max-width:760px){.shell{padding-left:18px;padding-right:18px}.route{grid-template-columns:1fr;gap:30px}.resource-grid{grid-template-columns:1fr}.section-title{display:block}.section-title span{display:block;margin-top:7px}}
</style>
