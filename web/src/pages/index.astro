---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { categories, resources } from '../data';
const featured = ['dw-nicos-weg', 'vhs-b1-course', 'testdaf-digital-prep', 'nachrichtenleicht'].map((id) => resources.find((resource) => resource.id === id)).filter(Boolean);
const current = resources.filter((resource) => resource.primaryCategory === 'news').slice(0, 3);
---
<BaseLayout title="德语学习导航" description="德语课程、考试、新闻、词典和学习方法的中文资源总入口。">
  <section class="hero shell"><div class="hero-copy"><p class="kicker">DEUTSCH LERNEN / RESOURCE MAP</p><h1>把德语学习<br /><em>整理成一张地图。</em></h1><p class="lead">从 A1 到 C1，从日常输入到考试输出。每个资源都告诉你是什么、适合谁，以及下一步怎么用。</p><form class="hero-search" action="/resources/" method="get"><input name="q" placeholder="搜索课程、考试、B1 听力、词典…" aria-label="搜索资源" /><button type="submit">开始查找 <span>↗</span></button></form><div class="quick-links"><a href="/resources/?level=B1">我在学 B1 <span>→</span></a><a href="/exams/">我要准备考试 <span>→</span></a><a href="/my-study/">安排我的学习 <span>→</span></a></div></div><div class="hero-index"><span class="index-label">当前地图</span><strong>01</strong><p>课程<br />考试<br />新闻<br />工具</p><span class="index-line"></span><span class="index-note">中文说明 · 来源可追溯</span></div></section>
  <section class="stats shell"><div><strong>{resources.length}</strong><span>已整理资源</span></div><div><strong>{categories.length}</strong><span>中文分类</span></div><div><strong>A1—C1</strong><span>分级路线</span></div><div><strong>0</strong><span id="site-views">累计访问（待上线统计）</span></div></section>
  <section class="section shell"><div class="section-heading"><div><p class="kicker">BROWSE BY PURPOSE</p><h2>先选你现在要做什么</h2></div><a href="/resources/" class="all-link">查看全部资源 <span>↗</span></a></div><div class="category-grid">{categories.map((category, index) => <a class="category-tile" href={`/resources/?category=${category.id}`}><span class="category-number">{String(index + 1).padStart(2, '0')}</span><strong>{category.name}</strong><p>{category.description}</p><span class="tile-arrow">→</span></a>)}</div></section>
  <section class="section featured-band"><div class="shell"><div class="section-heading"><div><p class="kicker">EDITOR'S SHORTLIST</p><h2>现在就能开始的入口</h2></div><span class="section-note">先选一个主线，再加一个输入源</span></div><div class="resource-grid">{featured.map((resource) => <ResourceCard resource={resource} compact />)}</div></div></section>
  <section class="section shell split-section"><div><p class="kicker">READ / LISTEN / REPEAT</p><h2>把新闻变成练习</h2><p class="section-copy">新闻不是收藏夹里的链接。按等级挑一篇，先读懂，再听一遍，最后用三句话复述。这里会把适合学习者的新闻入口和音频材料放在一起。</p><a class="button-link" href="/news/">进入新闻阅读 <span>→</span></a></div><div class="news-list">{current.map((resource) => <a href={`/resource/${resource.slug}/`}><span>{resource.levels.join(' · ')}</span><strong>{resource.titleZh}</strong><small>{resource.sourceName}</small></a>)}</div></section>
  <section class="bottom-cta shell"><div><p class="kicker">YOUR NEXT SESSION</p><h2>别再只收藏，开始安排这一周。</h2></div><a class="button-link dark" href="/my-study/">打开我的学习计划 <span>→</span></a></section>
</BaseLayout>
<style>
.shell{max-width:1260px;margin:0 auto;padding-left:28px;padding-right:28px}.hero{min-height:510px;padding-top:72px;display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:70px;align-items:center}.kicker{font:500 11px 'DM Mono',monospace;letter-spacing:.12em;color:var(--blue);margin:0 0 17px}.hero h1{font-size:clamp(44px,7vw,84px);line-height:1.03;letter-spacing:-.07em;margin:0 0 24px;font-weight:800}.hero h1 em{font-style:normal;color:var(--blue)}.lead{max-width:610px;color:#5d687b;font-size:16px;line-height:1.8;margin:0 0 27px}.hero-search{max-width:620px;background:white;border:1px solid #bbc9dd;border-radius:8px;padding:5px;display:flex;box-shadow:0 10px 30px rgba(31,65,120,.08)}.hero-search input{border:0;outline:0;padding:12px;font:14px Manrope;flex:1;min-width:0}.hero-search button{border:0;background:var(--blue);color:white;border-radius:5px;padding:0 18px;font-weight:700;cursor:pointer}.hero-search button span{font-size:17px;margin-left:6px}.quick-links{display:flex;gap:22px;margin-top:19px;flex-wrap:wrap}.quick-links a{color:#59677f;text-decoration:none;font-size:12px;font-weight:700}.quick-links a:hover{color:var(--blue)}.quick-links span{color:var(--blue);margin-left:4px}.hero-index{border-left:1px solid #c9d4e3;padding-left:25px;color:#8190a6;position:relative}.index-label{font:500 10px 'DM Mono',monospace;color:var(--blue)}.hero-index strong{display:block;font-size:102px;line-height:1;color:#d8e2f0;letter-spacing:-.1em;margin:17px 0}.hero-index p{font:500 12px/1.8 'DM Mono',monospace;color:#496181;margin:0}.index-line{display:block;width:46px;border-top:2px solid var(--gold);margin:22px 0}.index-note{font-size:11px}.stats{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);padding-top:19px;padding-bottom:19px}.stats div{display:flex;gap:12px;align-items:baseline;border-right:1px solid var(--line);padding-left:18px}.stats div:first-child{padding-left:0}.stats div:last-child{border:0}.stats strong{font-size:23px;letter-spacing:-.05em}.stats span{font-size:11px;color:#7b8798}.section{padding-top:90px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.section h2{font-size:33px;letter-spacing:-.06em;margin:0}.all-link,.button-link{color:var(--blue);font-size:12px;font-weight:800;text-decoration:none}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.category-tile{min-height:155px;padding:19px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);position:relative;text-decoration:none;background:rgba(255,255,255,.28);transition:background .2s}.category-tile:hover{background:white}.category-number{font:500 10px 'DM Mono',monospace;color:#92a0b4;display:block;margin-bottom:25px}.category-tile strong{font-size:15px}.category-tile p{color:#7a8698;font-size:11px;line-height:1.6;max-width:190px;margin:8px 0 0}.tile-arrow{position:absolute;right:18px;bottom:16px;color:var(--blue);font-size:18px}.featured-band{background:#edf2f9;padding-bottom:90px}.resource-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.section-note{font-size:12px;color:#8995a7}.split-section{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.section-copy{color:#687487;line-height:1.8;font-size:14px;max-width:480px;margin:20px 0 25px}.button-link{display:inline-flex;gap:8px;align-items:center}.button-link span{font-size:17px}.news-list{border-top:1px solid var(--line)}.news-list a{display:grid;grid-template-columns:70px 1fr 110px;gap:15px;align-items:center;padding:17px 0;border-bottom:1px solid var(--line);text-decoration:none}.news-list span,.news-list small{font:500 10px 'DM Mono',monospace;color:#738097}.news-list strong{font-size:14px}.bottom-cta{margin-top:95px;background:var(--blue-deep);color:white;padding-top:32px;padding-bottom:32px;display:flex;justify-content:space-between;align-items:center}.bottom-cta .kicker{color:#b7c9ff}.bottom-cta h2{font-size:25px;letter-spacing:-.05em;margin:0}.button-link.dark{background:var(--gold);color:#222b3b;padding:13px 17px;border-radius:5px}.bottom-cta.shell{max-width:1204px;padding-left:32px;padding-right:32px;margin-left:auto;margin-right:auto;border-radius:8px}@media(max-width:900px){.hero{grid-template-columns:1fr;gap:20px;padding-top:45px}.hero-index{display:none}.category-grid{grid-template-columns:repeat(2,1fr)}.resource-grid{grid-template-columns:repeat(2,1fr)}.split-section{gap:40px}.stats{grid-template-columns:repeat(2,1fr);gap:15px}.stats div:nth-child(2){border:0}}@media(max-width:600px){.shell{padding-left:18px;padding-right:18px}.hero{min-height:auto;padding-top:42px;padding-bottom:48px}.hero h1{font-size:48px}.lead{font-size:14px}.hero-search{display:block;padding:7px}.hero-search input{width:100%;padding:11px 8px}.hero-search button{height:40px;width:100%}.category-grid,.resource-grid{grid-template-columns:1fr}.category-tile{min-height:135px}.section{padding-top:58px}.split-section{grid-template-columns:1fr}.news-list a{grid-template-columns:55px 1fr}.news-list small{display:none}.bottom-cta{display:block;margin-top:58px}.bottom-cta .button-link{margin-top:20px}}
</style>
