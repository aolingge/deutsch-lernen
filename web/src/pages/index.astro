---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { categories, resources } from '../data';

const featured = ['dw-nicos-weg', 'vhs-b1-course', 'goethe-b1-practice', 'nachrichtenleicht']
  .map((id) => resources.find((resource) => resource.id === id))
  .filter(Boolean);
const news = resources.filter((resource) => resource.primaryCategory === 'news').slice(0, 3);
const categoryCount = (id: string) => resources.filter((resource) => resource.primaryCategory === id).length;
const routes = [
  { level: 'A1', verb: '开口生活', description: '自我介绍、问时间、完成简单对话', href: '/levels/a1/' },
  { level: 'A2', verb: '处理日常', description: '描述经历、安排计划、理解通知', href: '/levels/a2/' },
  { level: 'B1', verb: '独立表达', description: '讲清观点、写完整邮件、应对考试', href: '/levels/b1/' },
  { level: 'B2', verb: '展开论证', description: '读长文、比较立场、组织讨论', href: '/levels/b2/' },
  { level: 'C1', verb: '准确沟通', description: '理解复杂材料并清晰表达专业观点', href: '/levels/c1/' },
];
const studySteps = [
  { number: '01', title: '先听或读', detail: '选一段略有挑战的材料，先抓主题。', time: '10 分钟', tone: 'green' },
  { number: '02', title: '查明白', detail: '只查影响理解的词句，把语法放回原文。', time: '10 分钟', tone: 'yellow' },
  { number: '03', title: '合上材料回忆', detail: '口头复述要点，写下 3 个短语，不照抄。', time: '5 分钟', tone: 'red' },
  { number: '04', title: '换成自己的话', detail: '说一段或写几句，让输入变成可用表达。', time: '10 分钟', tone: 'blue' },
  { number: '05', title: '隔天再提取', detail: '隔一天、三天和一周再回忆并订正。', time: '5 分钟', tone: 'ink' },
];
---
<BaseLayout title="德语学习路线与资源地图" description="按 A1-C1 等级、听说读写技能和考试目标规划德语学习。包含中文学习指南、128 条精选资源、可执行的每周训练路线。">
  <section class="hero-band">
    <div class="hero shell">
      <div class="hero-copy">
        <p class="kicker">DEUTSCH LERNEN · 中文学习工作台</p>
        <h1>学会用德语<br /><em>完成下一件事。</em></h1>
        <p class="lead">从第一次自我介绍，到通过 B1 考试、读懂德国新闻。按你的水平与目标找到一条能走下去的路线。</p>
        <form class="hero-search" action="/resources/" method="get">
          <label class="visually-hidden" for="home-search">搜索德语课程、考试和训练资料</label>
          <input id="home-search" name="q" placeholder="搜 B1 听力、冠词、Goethe 考试…" />
          <button type="submit">找一份可用的资料 <span aria-hidden="true">↗</span></button>
        </form>
        <p class="search-note">搜索课程、练习、考试资料、词典和站内原创指南</p>
      </div>
      <div class="hero-map" aria-label="德语学习五步闭环：输入、理解、回忆、表达、复习">
        <div class="map-caption"><span>让每一次学习都留下结果</span><span>5 步 · 可重复</span></div>
        <ol class="study-loop">
          {studySteps.map((step) => <li class={`loop-step ${step.tone}`}>
            <span class="step-number">{step.number}</span>
            <div class="step-copy"><strong>{step.title}</strong><p>{step.detail}</p></div>
            <span class="step-time">{step.time}</span>
          </li>)}
        </ol>
        <p class="loop-foot"><span class="loop-dot"></span>复习后回到新材料 · 约 40 分钟完成一轮</p>
      </div>
    </div>
  </section>

  <section class="proof-strip shell" aria-label="网站内容概况">
    <div><strong data-resource-count>{resources.length}</strong><span>条已整理资源</span></div>
    <div><strong>{categories.length}</strong><span>个中文分类</span></div>
    <div><strong>A1 — C1</strong><span>连续学习路线</span></div>
    <div><strong>—</strong><span id="site-views">累计访问（读取中）</span></div>
    <a href="/sources/">来源与核验规则 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="section shell level-section">
    <div class="section-heading"><div><p class="kicker">01 / FIND YOUR NEXT LEVEL</p><h2>按水平走，先看自己要会什么</h2><p>每一级都从“能完成的沟通任务”出发，再连接语法、词汇和技能练习。</p></div><a class="text-link" href="/study/">查看完整学习路线 <span aria-hidden="true">↗</span></a></div>
    <div class="level-track" aria-label="A1 到 C1 德语能力成长路线">
      {routes.map((route, index) => <a class={`level-stop ${index === 2 ? 'current-level' : ''}`} href={route.href}>
        <span class="level-marker">{route.level}</span><span class="level-verb">{route.verb}</span><span class="level-description">{route.description}</span><span class="stop-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
    <p class="level-note">不确定当前水平？先用各级自检页确认，再选主线课程和训练材料。</p>
  </section>

  <section class="purpose-band">
    <div class="shell section">
      <div class="section-heading"><div><p class="kicker">02 / CHOOSE A PURPOSE</p><h2>你今天想解决哪件事？</h2><p>不用从 128 条里盲选。先选学习目的，再缩小范围。</p></div><a class="text-link" href="/resources/">打开资源筛选器 <span aria-hidden="true">↗</span></a></div>
      <div class="purpose-grid">
        <a class="purpose-item" href="/resources/?category=courses"><span class="purpose-index">A</span><span><strong>建立课程主线</strong><small>从系统课程和每日安排开始</small></span><b>{categoryCount('courses')} 条 <i aria-hidden="true">↗</i></b></a>
        <a class="purpose-item" href="/resources/?category=grammar"><span class="purpose-index">B</span><span><strong>补语法与词汇</strong><small>把规则放进句子、邮件和口语</small></span><b>{categoryCount('grammar') + categoryCount('vocabulary')} 条 <i aria-hidden="true">↗</i></b></a>
        <a class="purpose-item" href="/resources/?category=exams"><span class="purpose-index">C</span><span><strong>准备目标考试</strong><small>看考试结构，再练对应模块</small></span><b>{categoryCount('exams')} 条 <i aria-hidden="true">↗</i></b></a>
        <a class="purpose-item" href="/resources/?category=news"><span class="purpose-index">D</span><span><strong>听读真实德语</strong><small>按等级接触新闻、播客与视频</small></span><b>{categoryCount('news') + categoryCount('listening') + categoryCount('reading')} 条 <i aria-hidden="true">↗</i></b></a>
        <a class="purpose-item" href="/resources/?category=life"><span class="purpose-index">E</span><span><strong>准备德国生活</strong><small>查留学、办事、医疗与求职</small></span><b>{categoryCount('life')} 条 <i aria-hidden="true">↗</i></b></a>
      </div>
    </div>
  </section>

  <section class="section shell shortlist-section">
    <div class="section-heading"><div><p class="kicker">03 / START WITH A SMALL SET</p><h2>先搭一个不贪多的学习组合</h2><p>一个主线课程、一份真实输入、一个输出练习，再加一次复盘。</p></div><a class="text-link" href="/resources/">浏览全部 {resources.length} 条资源 <span aria-hidden="true">↗</span></a></div>
    <div class="resource-grid">{featured.map((resource) => <ResourceCard resource={resource} compact />)}</div>
  </section>

  <section class="section shell practice-section">
    <div class="practice-copy"><p class="kicker">04 / MAKE IT A WEEKLY HABIT</p><h2>资源只是材料，<br /><em>练习才会留下能力。</em></h2><p>把每周安排成输入、输出和复盘的循环。你不需要每天学很久，但每次都要留下能检查的结果：一段复述、一封邮件、一次录音，或一页错题复盘。</p><div class="practice-links"><a href="/study/b1-week/">打开 B1 一周示范计划 <span aria-hidden="true">↗</span></a><a href="/my-study/">把任务加入我的计划 <span aria-hidden="true">↗</span></a></div></div>
    <div class="week-board" aria-label="每周学习节奏示例">
      <div class="board-head"><strong>WOCHE 01</strong><span>示例节奏 · 每次 25–45 分钟</span></div>
      <div class="week-row"><span>MO</span><b>听一课</b><small>提取 5 个表达</small><i class="bar green-bar"></i></div>
      <div class="week-row"><span>DI</span><b>读一篇</b><small>合上材料复述</small><i class="bar yellow-bar"></i></div>
      <div class="week-row"><span>MI</span><b>写一封信</b><small>覆盖任务要点</small><i class="bar red-bar"></i></div>
      <div class="week-row"><span>DO</span><b>听写跟读</b><small>纠正重音和语序</small><i class="bar green-bar"></i></div>
      <div class="week-row"><span>FR</span><b>录一段口语</b><small>讲清观点和理由</small><i class="bar yellow-bar"></i></div>
      <div class="week-row"><span>SA</span><b>做一组专项</b><small>按考试时间完成</small><i class="bar red-bar"></i></div>
      <div class="week-row"><span>SO</span><b>复盘再安排</b><small>隔天主动回忆</small><i class="bar ink-bar"></i></div>
      <div class="board-footer"><span>听 · 读 · 写 · 说</span><span>每周留下一项可检查成果</span></div>
    </div>
  </section>

  <section class="news-band">
    <div class="section shell">
      <div class="section-heading"><div><p class="kicker">05 / GERMAN IN CONTEXT</p><h2>让德语回到真实世界</h2><p>从易读新闻开始，读完后用自己的德语说出主题、立场和一个新表达。</p></div><a class="text-link" href="/news/">打开德语新闻入口 <span aria-hidden="true">↗</span></a></div>
      <div class="news-list">{news.map((resource) => <a href={`/resource/${resource.slug}/`}><span>{resource.levels.join(' · ')}</span><strong>{resource.titleZh}</strong><small>{resource.sourceName}</small><b aria-hidden="true">↗</b></a>)}</div>
    </div>
  </section>

  <section class="section shell category-section">
    <div class="section-heading"><div><p class="kicker">06 / THE RESOURCE MAP</p><h2>需要查找具体材料？</h2><p>按用途进入分类；每条资源都附中文说明、等级、技能和使用条件。</p></div><span class="category-count">{categories.length} 个分类 · {resources.length} 条资源</span></div>
    <div class="category-grid">{categories.map((category, index) => <a class="category-tile" href={`/resources/?category=${category.id}`}><span class="category-number">{String(index + 1).padStart(2, '0')}</span><strong>{category.name}</strong><p>{category.description}</p><span class="tile-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>

  <section class="closing-band"><div class="shell closing-content"><div><p class="kicker">DEIN NÄCHSTER SCHRITT</p><h2>把下一次学习安排下来。</h2><p>计划保存在你的浏览器中；收藏、目标和完成记录不会上传到网站。</p></div><a href="/my-study/">打开我的学习计划 <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>

<style>
