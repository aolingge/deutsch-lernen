rgin-bottom:16px}.practice-copy h2 em{font-style:normal;color:#ac3d30}.practice-copy>p:not(.kicker){color:#626e64;font-size:14px;line-height:1.85;margin:19px 0 22px;max-width:470px}.practice-links{display:grid;gap:11px}.practice-links a{color:#a43b2f;text-decoration:none;font-size:12px;font-weight:800}.practice-links span{font-size:15px;margin-left:4px}.week-board{background:#fff;border:1px solid #d9ddd5;padding:19px 23px 13px;box-shadow:8px 8px 0 #e5e1d5}.board-head,.board-footer{display:flex;justify-content:space-between;gap:15px;align-items:center}.board-head{padding-bottom:14px;border-bottom:1px solid #e1e4dc}.board-head strong{font:700 11px 'DM Mono',monospace;color:#213b2f}.board-head span,.board-footer span{font-size:10px;color:#758075}.week-row{display:grid;grid-template-columns:36px 105px 1fr 68px;gap:10px;align-items:center;min-height:38px;border-bottom:1px solid #edf0e9}.week-row>span{font:10px 'DM Mono',monospace;color:#9b4235}.week-row>b{font-size:11px;color:#344239}.week-row small{font-size:10px;color:#7a8378}.bar{height:5px;border-radius:5px;width:100%;max-width:70px}.green-bar{background:#80a58a}.yellow-bar{background:#dfbd50}.red-bar{background:#c85f4e}.ink-bar{background:#273d33}.board-footer{padding-top:12px}.board-footer span:first-child{color:#35443b;font-weight:700}.news-band{background:#e7ebe5}.news-band .section{padding-block:66px}.news-list{border-top:1px solid #bfc8be}.news-list a{display:grid;grid-template-columns:85px 1fr 150px 20px;gap:15px;align-items:center;padding:17px 0;border-bottom:1px solid #bfc8be;text-decoration:none}.news-list a>span,.news-list small{font:10px 'DM Mono',monospace;color:#68756a}.news-list strong{font-size:14px;color:#20342a}.news-list b{color:#a63d30}.category-section{padding-top:68px;padding-bottom:80px}.category-count{font:11px 'DM Mono',monospace;color:#70796f;white-space:nowrap}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #cbd2ca;border-left:1px solid #cbd2ca}.category