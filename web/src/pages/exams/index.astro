---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { resources } from '../../data';
const examResources = resources.filter((resource) => resource.primaryCategory === 'exams');
---
<BaseLayout title="德语考试专区"><section class="exam-hero shell"><p class="kicker">EXAM ROUTES / GOETHE · TELC · TESTDAF</p><h1>先弄清楚考试，<br /><em>再开始刷题。</em></h1><p>不同考试的目的、题型和报名入口不一样。这里先给你选择方向，再进入官方材料。</p></section><section class="shell exam-map"><div class="exam-choice"><span>A1—B1</span><strong>日常交流与基础证书</strong><p>适合建立生活德语和基础考试能力，先用分级课程与四项技能练习。</p><a href="/resources/?level=B1">查看 B1 资源 →</a></div><div class="exam-choice"><span>B2—C1</span><strong>留学与高级表达</strong><p>重点转向长篇阅读、讲座听力、观点写作和口语论证。</p><a href="/resources/?level=C1">查看 C1 资源 →</a></div><div class="exam-choice"><span>大学语言证明</span><strong>TestDaF / DSH</strong><p>先确认目标大学接受哪种证明，再按考试版本准备对应模块。</p><a href="/resources/?exam=TestDaF">查看 TestDaF 资源 →</a></div></section><section class="shell exam-list"><div class="section-title"><h2>官方与考试入口</h2><span>每条都写清楚限制条件</span></div><div class="resource-grid">{examResources.map((resource) => <ResourceCard resource={resource} />)}</div></section></BaseLayout>
<style>.shell{max-width:1180px;margin:auto;padding-left:28px;padding-right:28px}.exam-hero{padding-top:65px;padding-bottom:52px}.kicker{font:500 11px 'DM Mono',monospace;letter-spacing:.12em;color:var(--blue)}.exam-hero h1{font-size:clamp(43px,6vw,70px);letter-spacing:-.07em;line-height:1.04;margin:20px 0}.exam-hero em{font-style:normal;color:var(--blue)}.exam-hero p:last-child{color:#687487;line-height:1.8;max-width:550px}.exam-map{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.exam-choice{background:var(--blue-deep);color:white;padding:24px;min-height:210px;border-radius:8px}.exam-choice:nth-child(2){background:#1e7664}.exam-choice:nth-child(3){background:#8c5d20}.exam-choice span{font:500 10px 'DM Mono',monospace;color:#d4e1ff}.exam-choice strong{display:block;font-size:21px;letter-spacing:-.04em;margin:20px 0 9px}.exam-choice p{font-size:12px;line-height:1.7;color:#d6def0}.exam-choice a{font-size:12px;font-weight:800;color:white;text-decoration:none}.exam-list{padding-top:85px;padding-bottom:80px}.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.section-title h2{font-size:28px;letter-spacing:-.05em;margin:0}.section-title span{font-size:11px;color:#7d899b}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}@media(max-width:760px){.shell{padding-left:18px;padding-right:18px}.exam-map,.resource-grid{grid-template-columns:1fr}.exam-list{padding-top:58px}.section-title{display:block}.section-title span{display:block;margin-top:7px}}
</style>
