---
import BaseLayout from '../../layouts/BaseLayout.astro';

const days = [
  { day: '周一', title: '课程输入：听懂一段，再讲出来', duration: '35 分钟', material: 'DW Nicos Weg B1 或 vhs-Lernportal B1', steps: ['完成一个小节，第一次不暂停，先写主题。', '第二次听，记下 5 个有用词组和 2 个转折表达。', '合上材料，用德语录 60 秒复述。'], output: '一段 60 秒录音 + 5 个词组', href: '/resources/?category=courses&level=B1' },
  { day: '周二', title: '听力训练：用证据解释答案', duration: '30 分钟', material: 'B1 短对话、公告或访谈', steps: ['听前根据标题预测人物、场景和目的。', '第一遍抓主旨，第二遍记录时间、数字、立场。', '对照文本订正；错题旁写出答案依据。'], output: '一张听力错因记录', href: '/resources/?category=listening&level=B1' },
  { day: '周三', title: '写作训练：完成一封任务完整的邮件', duration: '40 分钟', material: 'B1 邮件题或日常真实情境', steps: ['划出收件人、写信目的和每一个任务点。', '先列 4 段提纲，再限时写 100–150 词。', '检查称呼结尾、动词位置、从句语序和连接词。'], output: '一封订正后的邮件', href: '/resource/guide-writing-templates/' },
  { day: '周四', title: '阅读与词汇：摘搭配，不孤立背词', duration: '30 分钟', material: 'B1 新闻简讯、短文或课程阅读', steps: ['先看题目或小标题，再读全文抓段落作用。', '圈出 5 个高频搭配，写成带语境的短句。', '遮住中文提示，尝试回忆词义和搭配。'], output: '5 张有语境的复习卡', href: '/resources/?category=reading&level=B1' },
  { day: '周五', title: '口语训练：把经历和理由说清楚', duration: '30 分钟', material: '一个熟悉主题：工作、住房、旅行或学习', steps: ['准备 5 个关键词，不写完整讲稿。', '录音 2 分钟：观点、理由、例子、总结。', '回听并只修一个问题，再录一次。'], output: '前后两版口语录音', href: '/resource/guide-speaking-templates/' },
  { day: '周六', title: '考试专项：按规定时间完成一个模块', duration: '45 分钟', material: '目标考试的官方样题或模拟任务', steps: ['核对样题来源和考试版本。', '计时完成一个模块，不边做边查词。', '按任务完成度、时间和错误类型复盘。'], output: '一份模块成绩和错因清单', href: '/exams/' },
  { day: '周日', title: '间隔复习：回忆本周表达并安排下周', duration: '25 分钟', material: '本周词组卡、错题和两段录音', steps: ['先遮住答案，回忆周一和周四的表达。', '把答错的卡片放回较短复习间隔。', '选下周一个薄弱点，写下可检查的目标。'], output: '一张下周计划 + 需要重练的卡片', href: '/my-study/' },
];
---
<BaseLayout title="B1 一周德语训练计划" description="一份可以直接执行的 B1 每周训练示范，包含每天的材料、时长、练习步骤和成果标准，覆盖听说读写与复盘。">
  <section class="week-hero"><div class="shell"><p class="kicker">B1 · WOCHENPLAN</p><h1>一周练完听、说、读、写，<br /><em>每天都留下一个结果。</em></h1><p>适合已有 A2 基础、每周能安排约 4 小时的学习者。你可以更换材料，但保留“先输入、再回忆、最后输出”的步骤。</p><div class="week-facts"><span>7 天训练</span><span>3 小时 55 分钟</span><span>覆盖 4 项技能</span><span>每天 1 项成果</span></div></div></section>
  <section class="shell week-content"><div class="week-intro"><div><p class="kicker">HOW TO USE</p><h2>先选一条主线课程</h2><p>课程保证连续性；新闻、短文和考试样题负责增加真实输入；写作、录音和错题记录负责检查能不能独立使用。</p></div><div class="rule"><strong>完成标准</strong><p>不要以“看完材料”打勾。只有复述、邮件、口语录音、订正记录或主动回忆结果才算完成。</p></div></div>
    <div class="day-list">{days.map((item, index) => <article class="day-row"><div class="day-marker"><span>0{index + 1}</span><b>{item.day}</b></div><div class="day-main"><div class="day-title"><div><h2>{item.title}</h2><span>{item.duration} · {item.material}</span></div><a href={item.href}>打开材料 ↗</a></div><ol>{item.steps.map((step) => <li>{step}</li>)}</ol></div><div class="day-output"><small>本日成果</small><strong>{item.output}</strong></div></article>)}</div>
    <aside class="adjust"><strong>时间不够时</strong><p>保留 10 分钟输入、3 分钟合上材料回忆、2 分钟说或写。考试日期临近时，把周六模块练习换成目标考试官方样题，并保持每周至少一次口语与写作输出。</p></aside>
    <div class="next-actions"><a href="/resource/guide-b1-8-week-plan/">想慢一点打基础？看 B1 八周路线 ↗</a><a href="/resource/guide-b1-exam-guide/">已经确定考试？进入 B1 考试指南 ↗</a><a href="/my-study/">把任务加入我的学习计划 ↗</a></div>
  </section>
</BaseLayout>
<style>
.shell{width:min(100% - 48px,1180px);margin-inline:auto}.week-hero{background:#152b25;color:#f7f4ea;padding:63px 0 43px}.kicker{font:700 11px/1.4 'DM Mono',monospace;color:#ae4332;margin:0 0 15px}.week-hero .kicker{color:#e4c75a}.week-hero h1{font-size:clamp(39px,5.5vw,66px);line-height:1.14;letter-spacing:0;margin:0}.week-hero h1 em{color:#e4c75a;font-style:normal}.week-hero>div>p:not(.kicker){max-width:780px;font-size:14px;line-height:1.8;color:#d0dbd1;margin:17px 0 22px}.week-facts{display:flex;flex-wrap:wrap;gap:0}.week-facts span{font:10px 'DM Mono',monospace;color:#f0ebd9;padding:0 15px;border-right:1px solid #718075}.week-facts span:first-child{padding-left:0}.week-facts span:last-child{border:0}.week-content{padding-block:46px 75px}.week-intro{display:grid;grid-template-columns:1fr 300px;gap:50px;align-items:end;margin-bottom:25px}.week-intro h2{font-size:23px;margin:0}.week-intro p:not(.kicker){font-size:12px;line-height:1.8;color:#69756a;margin:9px 0 0}.rule{border-left:3px solid #c54834;padding-left:13px}.rule strong{font-size:11px;color:#a63e30}.rule p{font-size:11px;line-height:1.65;color:#687469;margin:5px 0 0}.day-list{border-top:1px solid #c8d0c6}.day-row{display:grid;grid-template-columns:90px minmax(0,1fr) 190px;gap:21px;padding:21px 0;border-bottom:1px solid #dce1da;align-items:start}.day-marker{display:flex;align-items:center;gap:10px}.day-marker span{font:10px 'DM Mono',monospace;color:#a64a3a}.day-marker b{font-size:12px;color:#2b3d31}.day-title{display:flex;justify-content:space-between;align-items:start;gap:15px}.day-title h2{font-size:15px;line-height:1.4;color:#27372d;margin:0}.day-title span{font-size:10px;color:#7c857a;display:block;margin-top:5px}.day-title a{font-size:10px;font-weight:800;color:#a23b2d;text-decoration:none;white-space:nowrap}.day-main ol{padding-left:17px;margin:13px 0 0}.day-main li{font-size:11px;line-height:1.75;color:#566258;padding-left:3px}.day-output{border-left:1px solid #d4dbd3;padding-left:14px;min-height:43px}.day-output small,.day-output strong{display:block}.day-output small{font:9px 'DM Mono',monospace;color:#92988e}.day-output strong{font-size:11px;line-height:1.6;color:#314338;margin-top:4px}.adjust{background:#f0eee5;border-left:3px solid #d1ad43;padding:13px 16px;margin-top:22px}.adjust strong{font-size:12px;color:#343d32}.adjust p{font-size:11px;line-height:1.75;color:#697269;margin:5px 0 0}.next-actions{display:flex;flex-wrap:wrap;gap:14px 24px;padding-top:22px}.next-actions a{font-size:11px;color:#a63e30;text-decoration:none;font-weight:800}
@media(max-width:720px){.shell{width:min(100% - 36px,1180px)}.week-hero{padding:48px 0 35px}.week-hero h1{font-size:40px}.week-content{padding-block:34px 54px}.week-intro{grid-template-columns:1fr;gap:19px}.day-row{grid-template-columns:1fr;gap:10px;padding:17px 0}.day-marker{gap:9px}.day-marker span{order:2}.day-title{flex-direction:column;gap:8px}.day-output{margin-top:0;border-left:0;border-top:1px dashed #d3dad2;padding:8px 0 0;min-height:auto}.day-output strong{margin-top:2px}.week-facts span{padding:0 8px;font-size:9px}}
@media(max-width:390px){.shell{width:min(100% - 28px,1180px)}.week-hero h1{font-size:35px}.week-facts{row-gap:9px}.week-facts span{font-size:8px}}
</style>
