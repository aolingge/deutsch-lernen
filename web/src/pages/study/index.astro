@media(max-width:390px){.shell,.review-content,.start-content{width:min(100% - 28px,1180px)}.study-hero h1{font-size:39px}.level-goal strong{font-size:12px}.level-goal small,.level-focus b{font-size:10px}.skill-item{min-height:246px}.review-clock{grid-template-columns:1fr 12px 1fr 12px 1fr 12px 1fr;gap:3px}.review-clock strong{font-size:24px}.review-clock span{font-size:9px}}
