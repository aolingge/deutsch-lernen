---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resources } from '../../data';

const levelPlans = [
  { level: 'A1', goal: '把基础句子说完整', output: '介绍自己、问答日常信息、写短消息。', focus: '高频词组 · 动词位置 · 听辨数字时间', href: '/levels/a1/' },
  { level: 'A2', goal: '处理常见生活情境', output: '讲述经历、预约办事、说明计划和理由。', focus: '过去时表达 · 介词格 · 简短邮件', href: '/levels/a2/' },
  { level: 'B1', goal: '独立完成生活沟通', output: '说明观点、写结构清楚的邮件、参与讨论。', focus: '四技能平衡 · 连接词 · 考试任务训练', href: '/levels/b1/' },
  { level: 'B2', goal: '读懂复杂观点并论证', output: '比较立场、组织论据、回应追问。', focus: '长材料 · 学术表达 · 观点结构', href: '/levels/b2/' },
  { level: 'C1', goal: '准确处理复杂材料', output: '概括论证、评价来源、表达细致立场。', focus: '学术听读 · 篇章组织 · 语体控制', href: '/levels/c1/' },
];
const skillPlans = [
  { name: 'Hören · 听力', question: '听完能复述什么？', action: '先猜场景，听主旨，再听数字、转折和态度。最后合上材料，用 3 句话复述。', href: '/resources/?category=listening' },
  { name: 'Lesen · 阅读', question: '作者想说明什么？', action: '先看任务，再定位关键词；标出段落作用、同义替换和观点依据。', href: '/resources/?category=reading' },
  { name: 'Schreiben · 写作', question: '任务点是否答全？', action: '列出对象、目的和要点；写完检查动词位置、连接词和称呼结尾。', href: '/resource/guide-writing-templates/' },
  { name: 'Sprechen · 口语', question: '我能不看稿说清楚吗？', action: '用关键词准备，录 1–3 分钟；回听时只挑一个表达问题改进。', href: '/resource/guide-speaking-templates/' },
];
const total = resources.length;
---
<BaseLayout title="德语学习路线" description="从 A1 到 C1 的德语学习路线总览：等级目标、四项技能训练、每周节奏、间隔复习和考试准备入口。">
  <section class="study-hero"><div class="shell"><p class="kicker">LERNWEG / 学习路线总览</p><h1>先确定方向，<br /><em>再把每次学习连起来。</em></h1><p class="intro">德语进步不是把资料全部看完，而是持续完成略有挑战的沟通任务。选一个当前水平，练习听、说、读、写，把新表达放进自己的句子里，再隔天回忆。</p><div class="hero-meta"><span>{total} 条中文标注资源</span><span>A1–C1 连续路线</span><span>任务与复盘配套</span></div></div></section>

  <section class="shell section">
    <div class="heading"><div><p class="kicker">01 / LEVELS</p><h2>按能力阶段选择学习重点</h2></div><a href="/resources/">按等级筛选资源 ↗</a></div>
    <div class="level-list">{levelPlans.map((plan, index) => <a href={plan.href} class={`level-row ${plan.level === 'B1' ? 'focus-level' : ''}`}><span class="level-index">0{index + 1}<b>{plan.level}</b></span><span class="level-goal"><strong>{plan.goal}</strong><small>{plan.output}</small></span><span class="level-focus"><small>重点训练</small><b>{plan.focus}</b></span><span class="arrow">↗</span></a>)}</div>
    <p class="note">等级描述是路线提示，不替代官方考试大纲。用每级自检页确认薄弱项；考试报名条件和题型以考试主办方最新说明为准。</p>
  </section>

  <section class="skill-band"><div class="shell section">
    <div class="heading"><div><p class="kicker">02 / FOUR SKILLS</p><h2>四项技能要互相喂养</h2><p>读到的表达拿去写，听到的句型拿去说。每项练习都留下一个可检查的产物。</p></div><a href="/resources/">查找技能资源 ↗</a></div>
    <div class="skill-grid">{skillPlans.map((skill, index) => <a class="skill-item" href={skill.href}><span class="skill-number">{String(index + 1).padStart(2, '0')}</span><h3>{skill.name}</h3><strong>{skill.question}</strong><p>{skill.action}</p><span class="skill-link">选择练习材料 ↗</span></a>)}</div>
  </div></section>

  <section class="shell section loop-section">
    <div class="loop-intro"><p class="kicker">03 / STUDY LOOP</p><h2>一次 30–45 分钟，<br />这样安排更有结果。</h2><p>这是一套可调整的通用流程。忙的时候做最小版：10 分钟输入、3 分钟合上材料回忆、2 分钟写下明天要复习的内容。</p><a href="/study/b1-week/">看 B1 一周示范计划 ↗</a></div>
    <ol class="loop-timeline"><li><span>10′</span><div><b>输入</b><p>听一小段或读一篇适合当前水平的材料。</p></div></li><li><span>10′</span><div><b>理解</b><p>查少量关键内容，记录词组而非孤立单词。</p></div></li><li><span>5′</span><div><b>主动回忆</b><p>合上材料，说出主题并写下 3 个新表达。</p></div></li><li><span>10′</span><div><b>迁移输出</b><p>用新表达讲经历、写邮件或回答问题。</p></div></li><li><span>5′</span><div><b>订正与排期</b><p>标一个需要修正的地方，安排隔天再提取。</p></div></li></ol>
  </section>

  <section class="review-band"><div class="shell review-content"><div><p class="kicker">04 / SPACED REVIEW</p><h2>新词不要只重看，<br />要在忘记前试着想起来。</h2><p>把表达写在卡片正面，中文场景或挖空句放背面。先遮住答案主动回忆，再核对词性、搭配和例句。可先按“当天、隔天、3 天后、1 周后”安排；答错的缩短间隔，稳定答对的逐渐拉长。</p></div><div class="review-clock" aria-label="复习时间间隔示例"><div><strong>0</strong><span>当天</span></div><i>→</i><div><strong>1</strong><span>隔天</span></div><i>→</i><div><strong>3</strong><span>3 天后</span></div><i>→</i><div><strong>7</strong><span>1 周后</span></div><small>间隔单位：天 · 按回忆难度调整</small></div></div></section>

  <section class="shell section exam-section"><div class="heading"><div><p class="kicker">05 / EXAM ROUTES</p><h2>考试准备从目标倒推</h2><p>先核对用途、认可机构和目标等级，再按官方模块格式安排模拟练习。</p></div><a href="/exams/">打开考试专区 ↗</a></div><div class="exam-grid"><a href="/resource/guide-b1-exam-guide/"><b>GOETHE / TELC</b><strong>B1 生活沟通与考试任务</strong><span>模块结构 · 练习策略 · 模考复盘 ↗</span></a><a href="/resource/guide-testdaf-c1-bridge/"><b>TESTDAF</b><strong>大学入学德语能力</strong><span>阅读、听力、写作与口语任务 ↗</span></a><a href="/resource/guide-dsh-prep-guide/"><b>DSH</b><strong>按目标院校核对要求</strong><span>校方规则 · 各模块训练 · 时间规划 ↗</span></a></div><p class="note">考试形式、收费、报名和成绩有效性可能变化。这里提供学习组织方式，关键政策请回到考试机构或目标院校官网确认。</p></section>

  <section class="start-band"><div class="shell start-content"><div><p class="kicker">WEITERLERNEN</p><h2>今天只选一个下一步。</h2><p>为自己选一个等级、一个本周目标和一个可以完成的小任务。</p></div><div><a class="primary" href="/my-study/">安排我的本周学习 ↗</a><a class="secondary" href="/resources/">浏览全部学习资源 ↗</a></div></div></section>
</BaseLayout>

<style>
.shell{width:min(100% - 48px,1180px);margin-inline:auto}.study-hero{background:#152b25;color:#f7f4ea;padding:68px 0 54px}.kicker{font:700 11px/1.4 'DM Mono',monospace;color:#ae4332;margin:0 0 15px}.study-hero .kicker{color:#e5c75a}.study-hero h1{font-size:clamp(42px,6.2vw,72px);line-height:1.12;letter-spacing:0;margin:0;max-width:920px}.study-hero h1 em{font-style:normal;color:#e5c75a}.intro{max-width:760px;color:#ced9d0;font-size:15px;line-height:1.9;margin:20px 0 25px}.hero-meta{display:flex;gap:0;flex-wrap:wrap}.hero-meta span{color:#e5e7db;font:10px 'DM Mono',monospace;border-right:1px solid #66766a;padding:0 18px}.hero-meta span:first-child{padding-left:0}.hero-meta span:last-child{border:0}.section{padding-block:68px}.heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.heading .kicker{margin-bottom:12px}.heading h2,.loop-intro h2,.review-content h2,.start-content h2{font-size:clamp(27px,3.5vw,38px);line-height:1.25;letter-spacing:0;margin:0;color:#1d2c23}.heading p:not(.kicker){font-size:13px;line-height:1.7;color:#69756a;margin:9px 0 0}.heading>a,.loop-intro>a{white-space:nowrap;color:#a84131;text-decoration:none;font-weight:800;font-size:12px}.level-list{border-top:1px solid #bdc6bc}.level-row{min-height:96px;display:grid;grid-template-columns:85px 1.1fr 1fr 20px;gap:18px;align-items:center;text-decoration:none;border-bottom:1px solid #d8ded6;padding:12px 8px 12px 0;transition:background .15s,padding .15s}.level-row:hover{background:#f0eee5;padding-left:9px}.focus-level{background:#f4eee3}.level-index{display:flex;align-items:center;gap:12px;color:#9a4335;font:10px 'DM Mono',monospace}.level-index b{font-size:13px;background:#e8eee7;color:#274331;width:39px;height:39px;border-radius:50%;display:grid;place-items:center}.focus-level .level-index b{background:#bd4633;color:white}.level-goal strong,.level-goal small,.level-focus small,.level-focus b{display:block}.level-goal strong{font-size:14px;color:#26372c}.level-goal small{font-size:11px;color:#748075;line-height:1.5;margin-top:4px}.level-focus small{font:10px 'DM Mono',monospace;color:#8b9388}.level-focus b{font-size:11px;color:#49574c;font-weight:600;margin-top:5px}.arrow{color:#ae4131}.note{font-size:10px;line-height:1.6;color:#7a847b;margin:12px 0 0}.skill-band{background:#f0eee5}.skill-band .section{padding-block:65px}.skill-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #c7c8bd;border-left:1px solid #c7c8bd}.skill-item{min-height:253px;padding:18px 17px 16px;border-right:1px solid #c7c8bd;border-bottom:1px solid #c7c8bd;text-decoration:none;display:flex;flex-direction:column;background:#f7f5ed}.skill-number{font:10px 'DM Mono',monospace;color:#a34635}.skill-item h3{font-size:17px;margin:24px 0 13px;color:#26372c}.skill-item>strong{font-size:12px;color:#a13e31}.skill-item p{font-size:11px;line-height:1.75;color:#69756a;margin:8px 0 14px}.skill-link{margin-top:auto;font-size:10px;font-weight:800;color:#374d3d}.loop-section{display:grid;grid-template-columns:minmax(0,.9fr) minmax(350px,1.1fr);gap:82px;align-items:center}.loop-intro h2{font-size:34px}.loop-intro>p:not(.kicker){font-size:13px;line-height:1.85;color:#69756b;margin:17px 0}.loop-timeline{list-style:none;margin:0;padding:0;position:relative}.loop-timeline::before{content:"";position:absolute;left:28px;top:28px;bottom:28px;border-left:1px solid #b7c3b8}.loop-timeline li{position:relative;display:grid;grid-template-columns:58px 1fr;gap:14px;min-height:73px;align-items:start;padding:8px 0}.loop-timeline li>span{z-index:1;width:55px;height:32px;display:grid;place-items:center;background:#e8eee7;border:1px solid #c4d0c5;border-radius:20px;font:10px 'DM Mono',monospace;color:#36543e}.loop-timeline li b{font-size:13px;color:#26372c}.loop-timeline li p{font-size:11px;color:#727d73;margin:4px 0 0;line-height:1.5}.review-band{background:#19362b;color:#eff3e8}.review-content{width:min(100% - 48px,1180px);margin-inline:auto;padding-block:60px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.review-content .kicker{color:#e3c75a}.review-content h2{color:#f3f1e6}.review-content>div:first-child>p:not(.kicker){max-width:550px;font-size:12px;color:#c5d2c5;line-height:1.9;margin:15px 0 0}.review-clock{display:grid;grid-template-columns:1fr 20px 1fr 20px 1fr 20px 1fr;align-items:center;gap:7px;border-top:1px solid #617368;border-bottom:1px solid #617368;padding:19px 0;position:relative}.review-clock>div{text-align:center}.review-clock strong{display:block;color:#e4ca62;font:700 29px 'DM Mono',monospace}.review-clock span{display:block;font-size:10px;color:#d5dfd3;margin-top:4px}.review-clock>i{text-align:center;color:#aab8aa;font-style:normal}.review-clock small{grid-column:1/-1;text-align:center;color:#adbcae;font-size:9px;margin-top:11px}.exam-section{padding-block:67px}.exam-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #cbd2ca;border-left:1px solid #cbd2ca}.exam-grid>a{min-height:141px;padding:18px;border-right:1px solid #cbd2ca;border-bottom:1px solid #cbd2ca;text-decoration:none;display:flex;flex-direction:column;gap:12px;background:#fbfbf7}.exam-grid>a>b{font:10px 'DM Mono',monospace;color:#a54032}.exam-grid>a>strong{font-size:15px;color:#26372c}.exam-grid>a>span{font-size:10px;color:#707a71;margin-top:auto}.start-band{background:#c54834;color:white}.start-content{width:min(100% - 48px,1180px);margin-inline:auto;padding-block:36px;display:flex;align-items:center;justify-content:space-between;gap:25px}.start-content .kicker{color:#f2dc8a}.start-content h2{color:#fff;font-size:29px}.start-content p:not(.kicker){color:#f6e0da;font-size:12px;margin:8px 0 0}.start-content>div:last-child{display:grid;gap:12px}.start-content a{text-decoration:none;font-size:11px;font-weight:800}.primary{background:#f0ca59;color:#19251f;padding:13px 16px;border-radius:4px}.secondary{color:#fff}
