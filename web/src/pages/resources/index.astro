---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import ResourceFilters from '../../components/ResourceFilters.astro';
import { categories, filterResources, resources } from '../../data';
const filtered = filterResources(resources, Astro.url.searchParams.get('q') ?? '', Astro.url.searchParams.get('level') ?? '', Astro.url.searchParams.get('category') ?? '', Astro.url.searchParams.get('skill') ?? '', Astro.url.searchParams.get('exam') ?? '');
const selectedCategory = categories.find((category) => category.id === Astro.url.searchParams.get('category'));
---
<BaseLayout title="全部资源"><section class="page-hero shell"><p class="kicker">RESOURCE INDEX / {filtered.length} RESULTS</p><h1>所有资源，<em>按你的问题排列。</em></h1><p>先筛选等级、技能或考试，再看每个资源的中文用途和使用条件。建议先选一个等级和一个技能，不要一次打开所有入口。</p><div class="catalog-guide"><div><b>01</b><strong>先定范围</strong><span>等级 · 技能 · 考试</span></div><div><b>02</b><strong>看懂一张卡</strong><span>用途 · 条件 · 来源</span></div><div><b>03</b><strong>留下结果</strong><span>收藏 · 加入本周计划</span></div></div></section><section class="shell catalog"><ResourceFilters /><div class="catalog-head"><span>{selectedCategory ? selectedCategory.name : '全部公开资源'} · {filtered.length} 条</span><span>按推荐顺序显示 · {filtered.length ? '先看前 24 条' : '调整筛选后再试'}</span></div>{filtered.length ? <div class="resource-grid">{filtered.map((resource) => <ResourceCard resource={resource} />)}</div> : <div class="empty"><strong>没有找到匹配资源</strong><p>换一个关键词，或清除筛选后从分类入口开始。</p><a class="button-link" href="/resources/">查看全部资源 →</a></div>}</section></BaseLayout>
<style>.shell{max-width:1260px;margin:auto;padding-left:28px;padding-right:28px}.page-hero{padding-top:70px;padding-bottom:44px}.kicker{font:700 11px 'DM Mono',monospace;letter-spacing:0;color:var(--blue);margin:0 0 18px}.page-hero h1{font-size:clamp(40px,6vw,68px);letter-spacing:0;line-height:1.08;margin:0 0 18px;color:var(--ink)}.page-hero h1 em{font-style:normal;color:var(--blue)}.page-hero p:last-of-type{color:#6e7a8c;font-size:15px;line-height:1.8;max-width:650px}.catalog-guide{display:grid;grid-template-columns:repeat(3,1fr);max-width:780px;margin-top:30px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.catalog-guide div{display:grid;grid-template-columns:30px 1fr;column-gap:10px;padding:13px 15px 13px 0;border-right:1px solid var(--line)}.catalog-guide div+div{padding-left:15px}.catalog-guide div:last-child{border:0}.catalog-guide b{grid-row:1/3;color:var(--blue);font:10px 'DM Mono',monospace}.catalog-guide strong{font-size:12px}.catalog-guide span{font-size:10px;color:#7b857b;margin-top:3px}.catalog{padding-bottom:80px}.catalog-head{display:flex;justify-content:space-between;margin:27px 0 15px;font:500 11px 'DM Mono',monospace;color:#79869a}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.empty{border:1px dashed #bdc8d8;background:white;padding:45px;text-align:center;color:#687487}.empty strong{color:var(--ink);font-size:18px}.empty p{font-size:13px}@media(max-width:900px){.resource-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.shell{padding-left:18px;padding-right:18px}.page-hero{padding-top:45px}.catalog-guide{grid-template-columns:1fr}.catalog-guide div,.catalog-guide div+div{padding:11px 0;border-right:0;border-bottom:1px solid var(--line)}.catalog-guide div:last-child{border:0}.resource-grid{grid-template-columns:1fr}.catalog-head{gap:15px;line-height:1.5;align-items:flex-start}.catalog-head span:last-child{text-align:right}}
</style>
