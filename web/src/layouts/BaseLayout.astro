---
const { title = '德语资源导航', description = '德语课程、词典、播客、考试、工具与德国生活信息目录。' } = Astro.props;
import PageViewTracker from '../components/PageViewTracker.astro';
const path = Astro.url.pathname;
const canonicalPath = ['/', '/resources/', '/study/'].includes(path) ? '/' : path;
const canonical = new URL(canonicalPath, Astro.site);
const privatePage = ['/favorites/', '/my-study/', '/admin/'].includes(path);
const catalog = ['/', '/resources/', '/study/'].includes(path) || path.startsWith('/resource/') || path.startsWith('/levels/');
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': catalog ? 'CollectionPage' : 'WebSite',
  name: `${title} · Deutsch Lernen`,
  description,
  url: canonical.href,
  isPartOf: { '@type': 'WebSite', name: 'Deutsch Lernen', url: new URL('/', Astro.site).href },
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta property="og:title" content={`${title} · Deutsch Lernen`} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content="website" /><meta property="og:locale" content="zh_CN" /><meta property="og:image" content={new URL('/og-directory.png', Astro.site)} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={new URL('/og-directory.png', Astro.site)} />{privatePage && <meta name="robots" content="noindex, follow" />}<link rel="stylesheet" href="/directory.css" /><meta name="theme-color" content="#214e40" /><title>{title} · Deutsch Lernen</title><script type="application/ld+json" set:html={structuredData}></script><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23214e40'/%3E%3Cpath d='M17 18h30v8H26v6h17v8H26v6h21v8H17z' fill='white'/%3E%3C/svg%3E" /></head>
<body><a class="skip-link" href="#main-content">跳到主要内容</a><header class="site-header shell"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">DE<span></span></span><span>德语资源导航<small>Deutsch Lernen</small></span></a><nav aria-label="主导航"><a href="/" aria-current={catalog ? 'page' : undefined}>资源目录</a><a href="/exams/" aria-current={path === '/exams/' ? 'page' : undefined}>考试资料</a><a href="/news/" aria-current={path === '/news/' ? 'page' : undefined}>新闻媒体</a><a href="/favorites/" aria-current={['/favorites/', '/my-study/'].includes(path) ? 'page' : undefined}>我的收藏</a></nav><a class="header-source" href="https://github.com/aolingge/deutsch-lernen" target="_blank" rel="noopener noreferrer">GitHub ↗</a></header><main id="main-content" tabindex="-1"><slot /></main><footer class="site-footer shell"><div><strong>Deutsch Lernen<span> / 德语资源导航</span></strong><p>只整理资源，直接连接原站。</p></div><div class="footer-links"><a href="/sources/">收录说明</a><a href="/privacy/">隐私</a><a href="https://github.com/aolingge/deutsch-lernen/issues" target="_blank" rel="noopener noreferrer">反馈 / 推荐资源 ↗</a></div><p class="footer-note">第三方内容的版权、费用和访问条件以原站为准。</p></footer><PageViewTracker /></body></html>
<script>import '../client/catalog';</script>

